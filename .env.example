# === 이 파일은 "템플릿"입니다. 실제 값은 여기 쓰지 마세요. ===
# 사용법: 이 파일을 복사해서 .env 를 만들고, .env 에만 실제 토큰을 넣으세요.
#   cp .env.example .env
# .env 는 .gitignore 에 등록돼 있어 커밋되지 않습니다.

# GitLab Personal Access Token (scope: api) — MCP 서버용
GITLAB_PERSONAL_ACCESS_TOKEN=

# GitLab API 엔드포인트 (SSAFY 자체 호스팅)
GITLAB_API_URL=https://lab.ssafy.com/api/v4

# =============================================================================
# MQTT Broker 접속 (Spring Backend)
# =============================================================================
# 아무것도 설정하지 않으면 application-local.yml 의 기본값
# (tcp://70.12.130.106:1883, 인증 없음)이 그대로 적용된다.
# 운영/EC2 브로커 주소와 비밀번호는 이 템플릿이 아니라 .env 에만 넣을 것.

# 예: tcp://70.12.130.106:1883 (공용 개발 브로커) / tcp://localhost:1883 (로컬)
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
# Backend inbound/outbound clientId. ROS2 브리지와 절대 겹치면 안 된다
# (같은 clientId 로 접속하면 먼저 붙은 쪽이 브로커에서 끊긴다).
MQTT_INBOUND_CLIENT_ID=
MQTT_OUTBOUND_CLIENT_ID=
# MQTT 인프라 전체 on/off. 기본 true, 테스트 프로필에서는 false.
MQTT_ENABLED=
# 구독 MQTT QoS. 확정 규격은 1이므로 특별한 이유 없이 바꾸지 말 것.
MQTT_DEFAULT_QOS=

# 측정 요청·세션 자동 만료(초)와 만료 확인 주기(ms)
STATION_SESSION_TTL_SECONDS=60
STATION_MOVE_TTL_SECONDS=300
STATION_SESSION_CLEANUP_INTERVAL_MS=5000

# =============================================================================
# MQTT Broker 접속 (ROS2 fast_mqtt_bridge)
# =============================================================================
# 브리지는 URL 이 아니라 host/port 를 따로 받는다(paho 인터페이스 그대로).
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=
MQTT_KEEPALIVE=
# ROS2 브리지 TLS. EC2 8883 사용 시 true와 Jetson의 CA 절대 경로를 지정한다.
MQTT_TLS_ENABLED=
MQTT_CA_CERT=
# 브리지 clientId — Backend 와 반드시 다르게 유지할 것.
MQTT_CLIENT_ID=
# 이 브리지가 담당하는 차량 ID. DB 에 등록된 vehicle_id 여야 한다.
VEHICLE_ID=

# =============================================================================
# MySQL (Spring Backend, local 프로필)
# =============================================================================
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# =============================================================================
# EC2 배포 (docker-compose.yml 이 읽는 값)
# =============================================================================
# 배포 서버에서는 이 키들을 `.env`(compose 용)와 `backend.env`(백엔드 컨테이너 용)
# 두 파일에 나눠 담는다. 둘 다 커밋 금지 — 템플릿은 backend.env.example 참조.
#
# ⚠️ NEXT_PUBLIC_* 는 Next.js **빌드 인자**다. 값을 바꾸면 컨테이너 재시작이 아니라
#    이미지 재빌드를 해야 반영된다(번들에 박힌다).
MYSQL_ROOT_PASSWORD=
NEXT_PUBLIC_API_BASE_URL=
# Isaac Sim WebRTC 스트리밍. 실측(2026-07-31)으로 열려 있는 포트는 8011·49100 이고
# 기본값 47998 은 리스닝 프로세스가 없었다(구버전 Omniverse 대역). 접속이 안 되면
# 이 값부터 의심할 것.
NEXT_PUBLIC_ISAAC_WEBRTC_SERVER=
NEXT_PUBLIC_ISAAC_WEBRTC_SIGNAL_PORT=49100
NEXT_PUBLIC_ISAAC_WEBRTC_MEDIA_PORT=47998
