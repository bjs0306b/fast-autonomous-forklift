<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fast.backend.ai.mapper.AiCargoDetectionBoxMapper">

    <resultMap id="aiCargoDetectionBoxResultMap" type="com.fast.backend.ai.domain.AiCargoDetectionBox">
        <id property="id" column="id"/>
        <result property="analysisId" column="analysis_id"/>
        <result property="className" column="class_name"/>
        <result property="confidence" column="confidence"/>
        <result property="bboxX" column="bbox_x"/>
        <result property="bboxY" column="bbox_y"/>
        <result property="bboxWidth" column="bbox_width"/>
        <result property="bboxHeight" column="bbox_height"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.fast.backend.ai.domain.AiCargoDetectionBox"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO ai_cargo_detection_box (
            analysis_id, class_name, confidence, bbox_x, bbox_y, bbox_width, bbox_height, created_at
        )
        VALUES (
            #{analysisId}, #{className}, #{confidence}, #{bboxX}, #{bboxY}, #{bboxWidth}, #{bboxHeight}, #{createdAt}
        )
    </insert>

    <select id="findByAnalysisId" resultMap="aiCargoDetectionBoxResultMap">
        SELECT id, analysis_id, class_name, confidence, bbox_x, bbox_y, bbox_width, bbox_height, created_at
        FROM ai_cargo_detection_box
        WHERE analysis_id = #{analysisId}
        ORDER BY id
    </select>

</mapper>
