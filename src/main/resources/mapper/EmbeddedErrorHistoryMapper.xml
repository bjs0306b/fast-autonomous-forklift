<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fast.backend.embedded.mapper.EmbeddedErrorHistoryMapper">

    <resultMap id="embeddedErrorHistoryResultMap" type="com.fast.backend.embedded.domain.EmbeddedErrorHistory">
        <id property="id" column="id"/>
        <result property="forkliftId" column="forklift_id"/>
        <result property="errorCode" column="error_code"/>
        <result property="errorSource" column="error_source"/>
        <result property="severity" column="severity"/>
        <result property="message" column="message"/>
        <result property="occurredAt" column="occurred_at"/>
        <result property="receivedAt" column="received_at"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.fast.backend.embedded.domain.EmbeddedErrorHistory"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO embedded_error_history (
            forklift_id, error_code, error_source, severity, message, occurred_at, received_at, created_at
        )
        VALUES (
            #{forkliftId}, #{errorCode}, #{errorSource}, #{severity}, #{message}, #{occurredAt}, #{receivedAt}, #{createdAt}
        )
    </insert>

    <select id="findRecentByForkliftId" resultMap="embeddedErrorHistoryResultMap">
        SELECT id, forklift_id, error_code, error_source, severity, message, occurred_at, received_at, created_at
        FROM embedded_error_history
        WHERE forklift_id = #{forkliftId}
        ORDER BY occurred_at DESC, id DESC
        LIMIT #{limit}
    </select>

</mapper>
