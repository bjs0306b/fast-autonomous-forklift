<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fast.backend.station.mapper.StationMeasurementBoxMapper">

    <resultMap id="stationMeasurementBoxResultMap" type="com.fast.backend.station.domain.StationMeasurementBox">
        <id property="id" column="id"/>
        <result property="stationMeasurementId" column="station_measurement_id"/>
        <result property="boxOrder" column="box_order"/>
        <result property="bboxX" column="bbox_x"/>
        <result property="bboxY" column="bbox_y"/>
        <result property="bboxWidth" column="bbox_width"/>
        <result property="bboxHeight" column="bbox_height"/>
        <result property="score" column="score"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.fast.backend.station.domain.StationMeasurementBox"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO station_measurement_box (
            station_measurement_id, box_order, bbox_x, bbox_y, bbox_width, bbox_height, score, created_at
        )
        VALUES (
            #{stationMeasurementId}, #{boxOrder}, #{bboxX}, #{bboxY}, #{bboxWidth}, #{bboxHeight}, #{score}, #{createdAt}
        )
    </insert>

    <select id="findByStationMeasurementId" resultMap="stationMeasurementBoxResultMap">
        SELECT id, station_measurement_id, box_order, bbox_x, bbox_y, bbox_width, bbox_height, score, created_at
        FROM station_measurement_box
        WHERE station_measurement_id = #{stationMeasurementId}
        ORDER BY box_order ASC, id ASC
    </select>

</mapper>
