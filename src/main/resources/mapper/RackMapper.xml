<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fast.backend.storage.mapper.RackMapper">

    <resultMap id="rackResultMap" type="com.fast.backend.storage.domain.Rack">
        <id property="id" column="id"/>
        <result property="rackCode" column="rack_code"/>
        <result property="rackName" column="rack_name"/>
        <result property="positionX" column="position_x"/>
        <result property="positionY" column="position_y"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.fast.backend.storage.domain.Rack"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO rack (rack_code, rack_name, position_x, position_y, created_at, updated_at)
        VALUES (#{rackCode}, #{rackName}, #{positionX}, #{positionY}, #{createdAt}, #{updatedAt})
    </insert>

    <select id="findById" resultMap="rackResultMap">
        SELECT id, rack_code, rack_name, position_x, position_y, created_at, updated_at
        FROM rack WHERE id = #{id}
    </select>

    <select id="findByRackCode" resultMap="rackResultMap">
        SELECT id, rack_code, rack_name, position_x, position_y, created_at, updated_at
        FROM rack WHERE rack_code = #{rackCode}
    </select>

</mapper>
