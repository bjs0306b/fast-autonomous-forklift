<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
    측정 세션과 단일 설비 점유(FR-202, prompt85).

    점유/해제를 조건부 UPDATE 한 문장으로 처리하는 이유: SELECT 로 비어 있는지 확인한 뒤 UPDATE 하면
    두 요청이 같은 빈 상태를 보고 둘 다 점유에 성공할 수 있다. WHERE 절에 조건을 넣어 DB 가
    한 번에 판정하게 하고, 영향받은 행 수로 승패를 가른다.
-->
<mapper namespace="com.fast.backend.station.mapper.StationSessionMapper">

    <resultMap id="stationSessionResultMap" type="com.fast.backend.station.domain.StationSession">
        <id property="sessionId" column="session_id"/>
        <result property="cargoId" column="cargo_id"/>
    </resultMap>

    <insert id="insert" parameterType="com.fast.backend.station.domain.StationSession">
        INSERT INTO station_session (session_id, cargo_id)
        VALUES (#{sessionId}, #{cargoId})
    </insert>

    <select id="findBySessionId" resultMap="stationSessionResultMap">
        SELECT session_id, cargo_id
        FROM station_session
        WHERE session_id = #{sessionId}
    </select>

    <select id="findActiveSession" resultMap="stationSessionResultMap">
        SELECT s.session_id, s.cargo_id
        FROM station_state st
        JOIN station_session s ON s.session_id = st.active_session_id
        WHERE st.singleton_id = 1
    </select>

    <!--
        설비를 점유한다. 유휴이거나 **TTL 이 만료된** 점유일 때만 성공한다(prompt106).

        만료 판정과 새 점유를 **한 문장**으로 처리하는 것이 핵심이다. "만료됐는지 SELECT 로 보고 →
        UPDATE" 로 나누면 두 요청이 같은 만료 상태를 보고 둘 다 회수에 성공한다. WHERE 절에 조건을
        전부 넣어 DB 가 한 번에 판정하게 하고 영향 행 수로 승패를 가린다(compare-and-set).

        expiredBefore 는 서버가 계산해 넘긴다(now - ttl). DB 의 NOW() 를 쓰지 않는 이유는
        테스트에서 시간을 고정할 수 없기 때문이다 — 애플리케이션 Clock 하나로 시각을 통일한다.

        acquired_at IS NULL 도 만료로 본다. 이 컬럼이 없던 시절에 점유된 행이거나 비정상적으로
        비어 있는 경우인데, 둘 다 "언제부터 점유됐는지 알 수 없다"는 뜻이라 회수 대상으로 둔다.
        NULL 을 영구 점유로 취급하면 이 기능이 고치려는 영구 잠금이 그대로 남는다.
    -->
    <update id="acquireStation">
        UPDATE station_state
        SET active_session_id = #{sessionId},
            acquired_at = #{acquiredAt}
        WHERE singleton_id = 1
          AND (
                active_session_id IS NULL
             OR acquired_at IS NULL
             OR acquired_at &lt;= #{expiredBefore}
          )
    </update>

    <update id="releaseStation">
        UPDATE station_state
        SET active_session_id = NULL,
            acquired_at = NULL
        WHERE singleton_id = 1
          AND active_session_id = #{sessionId}
    </update>

    <!--
        측정 결과가 저장된 뒤에만 세션을 종료한다(prompt96 3·20장).

        "measurement 존재 확인 → 해제" 를 두 문장으로 나누면 그 사이에 상태가 바뀔 수 있다.
        EXISTS 를 WHERE 절에 넣어 **한 문장**으로 판정·해제하면 그 틈이 없다. 영향 행 수가
        0 이면 호출자가 원인(활성 세션 불일치 / 측정 미완료)을 따로 조회해 구분한다 —
        전부 SESSION_NOT_FOUND 로 뭉개지 않는다.

        MySQL 은 UPDATE 대상 테이블을 서브쿼리에서 다시 읽는 것을 막지만, 여기서 EXISTS 가
        읽는 테이블은 station_measurement 로 UPDATE 대상(station_state)과 다르므로 문제없다.
        H2 MySQL 호환 모드에서도 동일하게 동작한다.
    -->
    <update id="releaseStationIfMeasurementExists">
        UPDATE station_state
        SET active_session_id = NULL,
            acquired_at = NULL
        WHERE singleton_id = 1
          AND active_session_id = #{sessionId}
          AND EXISTS (
              SELECT 1
              FROM station_measurement
              WHERE session_id = #{sessionId}
          )
    </update>

    <!--
        현재 점유 상태를 그대로 읽는다. 만료 여부 판정·로그에 acquired_at 이 필요해서 두었다.
        findActiveSession 은 station_session 과 JOIN 하므로 점유 세션이 없으면 행 자체가 없지만,
        이 조회는 station_state 한 행을 항상 돌려준다(유휴면 컬럼이 NULL).
    -->
    <select id="findState" resultType="com.fast.backend.station.domain.StationState">
        SELECT singleton_id      AS singletonId,
               active_session_id AS activeSessionId,
               acquired_at       AS acquiredAt
        FROM station_state
        WHERE singleton_id = 1
    </select>

    <!--
        점유 상태를 **행 잠금과 함께** 읽는다(prompt107 TOCTOU 방지).

        측정 저장은 "활성 세션이 맞는지 확인 → INSERT" 두 단계다. 그 사이에 force release 나
        TTL 회수가 끼어들면 **이미 해제된 세션의 측정이 저장된다.** SELECT ... FOR UPDATE 로
        station_state 한 행을 잠그면, 같은 행을 UPDATE 하는 acquireStation/releaseStation/
        forceReleaseStation 이 이 트랜잭션이 끝날 때까지 기다린다 — 검증과 INSERT 가 원자적으로 묶인다.

        잠그는 대상이 단일 행(singleton_id = 1)이라 경합 범위가 최소다.
        H2 MySQL 호환 모드와 MySQL 8 모두 FOR UPDATE 를 지원한다.
    -->
    <select id="findStateForUpdate" resultType="com.fast.backend.station.domain.StationState">
        SELECT singleton_id      AS singletonId,
               active_session_id AS activeSessionId,
               acquired_at       AS acquiredAt
        FROM station_state
        WHERE singleton_id = 1
        FOR UPDATE
    </select>

    <!--
        운영자 강제 해제(prompt106). 측정 행 존재 여부를 보지 않는다는 점만 빼면
        releaseStation 과 같다 — 측정을 저장하지 못한 채 죽은 세션을 푸는 것이 목적이라
        EXISTS 조건이 있으면 애초에 풀 수가 없다.

        요청한 sessionId 가 실제 점유 세션과 같을 때만 해제한다. 조건을 빼면 "지금 누가 점유했든
        무조건 푼다"가 되어, 운영자가 오래된 화면을 보고 누른 요청이 방금 시작된 정상 세션을
        끊어 버릴 수 있다.
    -->
    <update id="forceReleaseStation">
        UPDATE station_state
        SET active_session_id = NULL,
            acquired_at = NULL
        WHERE singleton_id = 1
          AND active_session_id = #{sessionId}
    </update>

</mapper>
