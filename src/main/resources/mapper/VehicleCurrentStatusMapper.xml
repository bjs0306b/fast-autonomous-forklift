<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fast.backend.vehicle.mapper.VehicleCurrentStatusMapper">

    <resultMap id="vehicleCurrentStatusResultMap" type="com.fast.backend.vehicle.domain.VehicleCurrentStatus">
        <id property="vehicleId" column="vehicle_id"/>
        <result property="status" column="status"/>
        <result property="battery" column="battery"/>
        <result property="positionX" column="position_x"/>
        <result property="positionY" column="position_y"/>
        <result property="heading" column="heading"/>
        <result property="speed" column="speed"/>
        <result property="forkHeight" column="fork_height"/>
        <result property="hasCargo" column="has_cargo"/>
        <result property="cargoId" column="cargo_id"/>
        <result property="footprintLength" column="footprint_length"/>
        <result property="footprintWidth" column="footprint_width"/>
        <result property="messageAt" column="message_at"/>
        <!-- received_at: 일반 상태·위치·포크 메시지가 공유한다. "마지막으로 DB 에 반영된
             유효한 차량 메시지의 백엔드 수신 시각"이며 특정 토픽으로 한정하지 않는다. -->
        <result property="receivedAt" column="received_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="currentStatusColumns">
        vehicle_id, status, battery, position_x, position_y, heading, speed,
        fork_height, has_cargo, cargo_id, footprint_length, footprint_width,
        message_at, received_at, updated_at
    </sql>

    <select id="findByVehicleId" resultMap="vehicleCurrentStatusResultMap">
        SELECT <include refid="currentStatusColumns"/>
        FROM vehicle_current_status
        WHERE vehicle_id = #{vehicleId}
    </select>

    <select id="findAllByVehicleIds" resultMap="vehicleCurrentStatusResultMap">
        SELECT <include refid="currentStatusColumns"/>
        FROM vehicle_current_status
        WHERE vehicle_id IN
        <foreach collection="list" item="vehicleId" open="(" separator="," close=")">
            #{vehicleId}
        </foreach>
    </select>

    <!--
        Isaac 확장 컬럼도 다른 컬럼과 동일하게 "전달된 값으로 그대로 덮어쓴다". 여기서 COALESCE로
        보존하지 않는 이유: 어떤 값을 유지하고 어떤 값을 지울지는 "메시지 종류"에 달린 판단인데,
        SQL은 호출자가 ROS2인지 Isaac인지 알 수 없다. 그래서 병합 판단은 전부
        VehicleStatusService가 하고(그 클래스는 이미 stale 비교를 위해 기존 행을 읽어둔다),
        Mapper는 "결정된 최종 상태를 쓴다"는 단일 책임만 갖는다. 이렇게 두면 이력 테이블에 저장되는
        값과 현재 상태 테이블에 저장되는 값이 항상 같은 객체에서 나와 서로 어긋날 수 없다.
    -->
    <insert id="upsert" parameterType="com.fast.backend.vehicle.domain.VehicleCurrentStatus">
        INSERT INTO vehicle_current_status
            (vehicle_id, status, battery, position_x, position_y, heading, speed,
             fork_height, has_cargo, cargo_id, footprint_length, footprint_width,
             message_at, received_at, updated_at)
        VALUES
            (#{vehicleId}, #{status}, #{battery}, #{positionX}, #{positionY}, #{heading}, #{speed},
             #{forkHeight}, #{hasCargo}, #{cargoId}, #{footprintLength}, #{footprintWidth},
             #{messageAt}, #{receivedAt}, #{updatedAt})
        ON DUPLICATE KEY UPDATE
            status = VALUES(status),
            battery = VALUES(battery),
            speed = VALUES(speed),
            fork_height = VALUES(fork_height),
            has_cargo = VALUES(has_cargo),
            cargo_id = VALUES(cargo_id),
            footprint_length = VALUES(footprint_length),
            footprint_width = VALUES(footprint_width),
            message_at = VALUES(message_at),
            received_at = VALUES(received_at),
            updated_at = VALUES(updated_at)
    </insert>

    <!--
        활성 차량 기준 상태별 집계. vehicle_current_status에 아직 행이 없는(=한 번도 상태를 받은 적
        없는) 활성 차량도 LEFT JOIN + COALESCE로 UNKNOWN에 포함시킨다(prompt16.md 14장 분석 결과,
        answer15.md 11장에서 상세 설명). 상태 enum이 10종으로 확장돼도(prompt32.md 1장 3번) 이 쿼리는
        상태 값을 문자열로 GROUP BY할 뿐이라 그대로 동작한다 — 응답에 10종을 0으로 채우는 책임은
        VehicleService#countByStatus에 있다.
    -->
    <select id="countByStatusForActiveVehicles" resultType="com.fast.backend.vehicle.mapper.VehicleStatusCountRow">
        SELECT COALESCE(s.status, 'UNKNOWN') AS status, COUNT(*) AS count
        FROM vehicle v
        LEFT JOIN vehicle_current_status s ON v.vehicle_id = s.vehicle_id
        WHERE v.active = true
        GROUP BY COALESCE(s.status, 'UNKNOWN')
    </select>

</mapper>
