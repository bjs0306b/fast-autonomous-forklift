<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fast.backend.vehicle.mapper.VehicleStatusHistoryMapper">

    <resultMap id="result" type="com.fast.backend.vehicle.domain.VehicleStatusHistory">
        <id property="historyId" column="history_id"/>
        <result property="vehicleId" column="vehicle_id"/>
        <result property="status" column="status"/>
        <result property="battery" column="battery"/>
        <result property="messageAt" column="message_at"/>
        <result property="receivedAt" column="received_at"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="columns">
        history_id, vehicle_id, status, battery, message_at, received_at, created_at
    </sql>

    <!-- 기간은 from <= message_at < to. message_at이 없는 이력은 기간 조건이 있으면 자연히 제외된다. -->
    <sql id="conditions">
        <where>
            vehicle_id = #{vehicleId}
            <if test="from != null">AND message_at &gt;= #{from}</if>
            <if test="to != null">AND message_at &lt; #{to}</if>
            <if test="status != null">AND status = #{status}</if>
        </where>
    </sql>

    <insert id="insert" parameterType="com.fast.backend.vehicle.domain.VehicleStatusHistory"
            useGeneratedKeys="true" keyProperty="historyId" keyColumn="history_id">
        INSERT INTO vehicle_status_history
            (vehicle_id, status, battery, message_at, received_at)
        VALUES
            (#{vehicleId}, #{status}, #{battery}, #{messageAt}, #{receivedAt})
    </insert>

    <select id="findByVehicleId" resultMap="result">
        SELECT <include refid="columns"/> FROM vehicle_status_history
        <include refid="conditions"/>
        ORDER BY message_at DESC, history_id DESC LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countByVehicleId" resultType="long">
        SELECT COUNT(*) FROM vehicle_status_history
        <include refid="conditions"/>
    </select>
</mapper>
