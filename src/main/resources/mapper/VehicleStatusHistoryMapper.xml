<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fast.backend.vehicle.mapper.VehicleStatusHistoryMapper">

    <resultMap id="vehicleStatusHistoryResultMap" type="com.fast.backend.vehicle.domain.VehicleStatusHistory">
        <id property="id" column="id"/>
        <result property="vehicleId" column="vehicle_id"/>
        <result property="status" column="status"/>
        <result property="battery" column="battery"/>
        <result property="positionX" column="position_x"/>
        <result property="positionY" column="position_y"/>
        <result property="heading" column="heading"/>
        <result property="speed" column="speed"/>
        <result property="messageAt" column="message_at"/>
        <result property="receivedAt" column="received_at"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.fast.backend.vehicle.domain.VehicleStatusHistory"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO vehicle_status_history (
            vehicle_id, status, battery, position_x, position_y, heading, speed,
            message_at, received_at, created_at
        )
        VALUES (
            #{vehicleId}, #{status}, #{battery}, #{positionX}, #{positionY}, #{heading}, #{speed},
            #{messageAt}, #{receivedAt}, #{createdAt}
        )
    </insert>

    <select id="findRecentByVehicleId" resultMap="vehicleStatusHistoryResultMap">
        SELECT id, vehicle_id, status, battery, position_x, position_y, heading, speed,
               message_at, received_at, created_at
        FROM vehicle_status_history
        WHERE vehicle_id = #{vehicleId}
        ORDER BY message_at DESC, id DESC
        LIMIT #{limit}
    </select>

</mapper>
