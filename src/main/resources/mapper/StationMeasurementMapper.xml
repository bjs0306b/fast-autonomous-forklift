<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fast.backend.station.mapper.StationMeasurementMapper">

    <resultMap id="stationMeasurementResultMap" type="com.fast.backend.station.domain.StationMeasurement">
        <id property="id" column="sequence_no"/>
        <result property="measurementId" column="measurement_id"/>
        <result property="sessionId" column="session_id"/>
        <result property="status" column="status"/>
        <result property="cargoHeight" column="cargo_height"/>
        <result property="tippingLevel" column="tipping_level"/>
        <result property="overhangRatio" column="overhang_ratio"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="columns">
        sequence_no, measurement_id, session_id, status,
        cargo_height, tipping_level, overhang_ratio, created_at
    </sql>

    <insert id="insert" parameterType="com.fast.backend.station.domain.StationMeasurement"
            useGeneratedKeys="true" keyProperty="id" keyColumn="sequence_no">
        INSERT INTO station_measurement
            (measurement_id, session_id, status, cargo_height, tipping_level, overhang_ratio, created_at)
        VALUES
            (#{measurementId}, #{sessionId}, #{status}, #{cargoHeight}, #{tippingLevel}, #{overhangRatio}, #{createdAt})
    </insert>

    <select id="existsByMeasurementId" resultType="boolean">
        SELECT COUNT(*) > 0 FROM station_measurement WHERE measurement_id = #{measurementId}
    </select>

    <select id="findByMeasurementId" resultMap="stationMeasurementResultMap">
        SELECT <include refid="columns"/> FROM station_measurement WHERE measurement_id = #{measurementId}
    </select>

    <select id="existsBySessionId" resultType="boolean">
        SELECT COUNT(*) > 0 FROM station_measurement WHERE session_id = #{sessionId}
    </select>

    <select id="findLatestBySessionId" resultMap="stationMeasurementResultMap">
        SELECT <include refid="columns"/>
        FROM station_measurement
        WHERE session_id = #{sessionId}
        ORDER BY sequence_no DESC
        LIMIT 1
    </select>

    <!-- record 는 setter 가 없으므로 생성자 매핑을 명시한다(자동 추론에 기대지 않는다). -->
    <resultMap id="cargoMeasuredHeightResultMap" type="com.fast.backend.station.dto.CargoMeasuredHeight">
        <constructor>
            <idArg column="cargo_id" javaType="java.lang.String"/>
            <arg column="cargo_height" javaType="java.lang.Double"/>
        </constructor>
    </resultMap>

    <!-- 화물 목록의 최근 측정 높이. 대시보드 차량 수와 무관하게 항상 1회만 실행된다(N+1 방지). -->
    <select id="findLatestCargoHeights" resultMap="cargoMeasuredHeightResultMap">
        SELECT s.cargo_id AS cargo_id, m.cargo_height AS cargo_height
        FROM station_measurement m
        JOIN station_session s ON s.session_id = m.session_id
        WHERE m.cargo_height IS NOT NULL
          AND s.cargo_id IN
        <foreach collection="cargoIds" item="cargoId" open="(" separator="," close=")">
            #{cargoId}
        </foreach>
        ORDER BY m.sequence_no ASC
    </select>

</mapper>
