<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fast.backend.ai.mapper.AiCargoAnalysisMapper">

    <resultMap id="aiCargoAnalysisResultMap" type="com.fast.backend.ai.domain.AiCargoAnalysis">
        <id property="id" column="id"/>
        <result property="analysisId" column="analysis_id"/>
        <result property="schemaVersion" column="schema_version"/>
        <result property="vehicleId" column="vehicle_id"/>
        <result property="cargoId" column="cargo_id"/>
        <result property="status" column="status"/>
        <result property="distanceCm" column="distance_cm"/>
        <result property="distanceStdCm" column="distance_std_cm"/>
        <result property="widthCm" column="width_cm"/>
        <result property="heightCm" column="height_cm"/>
        <result property="depthCm" column="depth_cm"/>
        <result property="volumeCm3" column="volume_cm3"/>
        <result property="dimensionScale" column="dimension_scale"/>
        <result property="loadDirection" column="load_direction"/>
        <result property="loadMessage" column="load_message"/>
        <result property="ratioHorizontal" column="ratio_horizontal"/>
        <result property="ratioVertical" column="ratio_vertical"/>
        <result property="message" column="message"/>
        <result property="capturedAt" column="captured_at"/>
        <result property="processedAt" column="processed_at"/>
        <result property="receivedAt" column="received_at"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.fast.backend.ai.domain.AiCargoAnalysis"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO ai_cargo_analysis (
            analysis_id, schema_version, vehicle_id, cargo_id, status,
            distance_cm, distance_std_cm,
            width_cm, height_cm, depth_cm, volume_cm3, dimension_scale,
            load_direction, load_message,
            ratio_horizontal, ratio_vertical,
            message, captured_at, processed_at, received_at, created_at
        )
        VALUES (
            #{analysisId}, #{schemaVersion}, #{vehicleId}, #{cargoId}, #{status},
            #{distanceCm}, #{distanceStdCm},
            #{widthCm}, #{heightCm}, #{depthCm}, #{volumeCm3}, #{dimensionScale},
            #{loadDirection}, #{loadMessage},
            #{ratioHorizontal}, #{ratioVertical},
            #{message}, #{capturedAt}, #{processedAt}, #{receivedAt}, #{createdAt}
        )
    </insert>

    <select id="existsByAnalysisId" resultType="boolean">
        SELECT COUNT(*) > 0
        FROM ai_cargo_analysis
        WHERE analysis_id = #{analysisId}
    </select>

    <select id="findByAnalysisId" resultMap="aiCargoAnalysisResultMap">
        SELECT *
        FROM ai_cargo_analysis
        WHERE analysis_id = #{analysisId}
    </select>

    <select id="findLatestByCargoId" resultMap="aiCargoAnalysisResultMap">
        SELECT *
        FROM ai_cargo_analysis
        WHERE cargo_id = #{cargoId}
        ORDER BY processed_at DESC, id DESC
        LIMIT 1
    </select>

</mapper>
