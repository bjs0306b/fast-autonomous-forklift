<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fast.backend.storage.mapper.CargoMapper">

    <resultMap id="cargoResultMap" type="com.fast.backend.storage.domain.Cargo">
        <id property="id" column="id"/>
        <result property="cargoId" column="cargo_id"/>
        <result property="width" column="width"/>
        <result property="length" column="length"/>
        <result property="height" column="height"/>
        <result property="volume" column="volume"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.fast.backend.storage.domain.Cargo"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO cargo (cargo_id, width, length, height, volume, created_at, updated_at)
        VALUES (#{cargoId}, #{width}, #{length}, #{height}, #{volume}, #{createdAt}, #{updatedAt})
    </insert>

    <select id="findById" resultMap="cargoResultMap">
        SELECT id, cargo_id, width, length, height, volume, created_at, updated_at
        FROM cargo WHERE id = #{id}
    </select>

    <select id="findByCargoId" resultMap="cargoResultMap">
        SELECT id, cargo_id, width, length, height, volume, created_at, updated_at
        FROM cargo WHERE cargo_id = #{cargoId}
    </select>

    <select id="existsByCargoId" resultType="boolean">
        SELECT COUNT(*) > 0 FROM cargo WHERE cargo_id = #{cargoId}
    </select>

</mapper>
