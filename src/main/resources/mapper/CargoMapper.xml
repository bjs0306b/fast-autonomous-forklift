<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- FR-202 최종 스키마(prompt85): cargo 는 cargo_id(PK) + created_at 두 컬럼뿐이다. -->
<mapper namespace="com.fast.backend.storage.mapper.CargoMapper">

    <resultMap id="cargoResultMap" type="com.fast.backend.storage.domain.Cargo">
        <id property="cargoId" column="cargo_id"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.fast.backend.storage.domain.Cargo">
        INSERT INTO cargo (cargo_id, created_at)
        VALUES (#{cargoId}, #{createdAt})
    </insert>

    <select id="findByCargoId" resultMap="cargoResultMap">
        SELECT cargo_id, created_at FROM cargo WHERE cargo_id = #{cargoId}
    </select>

    <select id="existsByCargoId" resultType="boolean">
        SELECT COUNT(*) > 0 FROM cargo WHERE cargo_id = #{cargoId}
    </select>

</mapper>
