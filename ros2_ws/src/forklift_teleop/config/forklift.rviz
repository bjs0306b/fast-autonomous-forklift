Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /TF1
        - /ToF left1
        - /ToF right1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 40
      Color: 160; 160; 164
      Alpha: 0.3
      # Empty means "whatever the fixed frame is", so the grid never asks for
      # a transform that may not exist yet and errors before SLAM has run.
      Reference Frame: <Fixed Frame>

    # Every geometry question in procedure J is really a TF question. Leave
    # this on: a point cloud in the right place under the wrong transform is
    # indistinguishable from a wrong cloud until the frames are visible.
    # Off by default and slow to update: at Update Interval 0 this recomputes
    # every frame for every frame in the tree, which is one of the more
    # expensive displays here. Turn it on when a transform is in question.
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.15
      Update Interval: 0.5
      Frame Timeout: 15

    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR scan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Size (m): 0.015
      Style: Spheres
      Color: 255; 255; 255
      Color Transformer: FlatColor
      Decay Time: 0

    # Sized larger than the lidar points on purpose. There are at most 64 of
    # them per sensor against a few hundred lidar returns, and the whole point
    # of this display is telling whether the ToF sees something the lidar
    # cannot -- which only reads if the sparse cloud is the visible one.
    - Class: rviz_default_plugins/PointCloud2
      Name: ToF left
      Enabled: true
      Topic:
        Value: /tof/left/points
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Size (m): 0.03
      Style: Spheres
      Color: 0; 255; 128
      Color Transformer: FlatColor
      Decay Time: 0

    # "측정했는데 아무것도 없다" 광선. 장애물이 아니라 **지워진 공간**이므로
    # 색을 다르게 두고 기본은 꺼 둔다 -- 켜 두면 앞쪽이 점으로 덮여 정작 봐야
    # 할 장애물이 안 보인다. 소멸이 왜 안 되는지 볼 때만 켤 것.
    - Class: rviz_default_plugins/PointCloud2
      Name: ToF clear rays (left)
      Enabled: false
      Topic:
        Value: /tof/left/points_clear
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Size (m): 0.02
      Style: Points
      Color: 80; 80; 255
      Color Transformer: FlatColor
      Decay Time: 0

    - Class: rviz_default_plugins/PointCloud2
      Name: ToF clear rays (right)
      Enabled: false
      Topic:
        Value: /tof/right/points_clear
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Size (m): 0.02
      Style: Points
      Color: 80; 80; 255
      Color Transformer: FlatColor
      Decay Time: 0

    - Class: rviz_default_plugins/PointCloud2
      Name: ToF right
      Enabled: true
      Topic:
        Value: /tof/right/points
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Size (m): 0.03
      Style: Spheres
      Color: 255; 128; 0
      Color Transformer: FlatColor
      Decay Time: 0

    # 심에서 만든 지도(또는 SLAM 지도). 스캔 점이 이 벽 위에 얹히는지가
    # "차를 맞는 자리에 놓았는가" 를 눈으로 보는 방법이다. 어긋나 있으면
    # 2D Pose Estimate 로 실제 위치를 찍어 고친다.
    #
    # costmap 아래에 두려고 먼저 선언한다 -- RViz 는 나중 것을 위에 그린다.
    - Class: rviz_default_plugins/Map
      Name: Map (sim or SLAM)
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Color Scheme: map
      Alpha: 0.7

    # The local costmap is where the two sensors have to agree. A ToF mark that
    # appears here and then disappears as the vehicle turns is the lidar
    # raytracing through it, which is what clearing:False and the VoxelLayer
    # are there to prevent.
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Topic:
        Value: /local_costmap/costmap
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Color Scheme: costmap
      Alpha: 0.6

    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: false
      Topic:
        Value: /global_costmap/costmap
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Color Scheme: costmap
      Alpha: 0.4

    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Topic:
        Value: /local_costmap/published_footprint
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color: 255; 255; 0
      Alpha: 1

    # 주행이 멈추면 이유가 최소 넷이다(가드·플래너·컨트롤러·브리지). 밖에서는
    # 넷이 똑같이 "안 움직인다" 로 보이므로, debug_hud 가 차 위에 여섯 줄로
    # 모아 띄운다. 원격 RViz 에서 이것 하나가 점군 전부보다 답을 많이 준다.
    - Class: rviz_default_plugins/MarkerArray
      Name: 상태 HUD
      Enabled: true
      Topic:
        Value: /debug/hud
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Volatile

    # 플래너가 낸 경로. 0점이면 플래너, 있는데 안 가면 컨트롤러다.
    - Class: rviz_default_plugins/Path
      Name: 전역 경로 /plan
      Enabled: true
      Topic:
        Value: /plan
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color: 0; 255; 0
      Line Style: Lines
      Alpha: 1

    # 컨트롤러가 실제로 따라가는 궤적. 전역 경로와 크게 어긋나면 추종 실패다.
    - Class: rviz_default_plugins/Path
      Name: 지역 경로 /local_plan
      Enabled: true
      Topic:
        Value: /local_plan
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color: 255; 0; 255
      Line Style: Lines
      Alpha: 1

    - Class: rviz_default_plugins/Odometry
      Name: EKF odometry
      Enabled: false
      Topic:
        Value: /odometry/filtered
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Keep: 50
      Shape:
        Value: Arrow
        Alpha: 1
        Shaft Length: 0.1
        Shaft Radius: 0.01
        Head Length: 0.04
        Head Radius: 0.02

  Global Options:
    # odom, not map. A goal has to be dropped in a frame that stays put, and
    # base_link does not -- it travels with the vehicle and takes the goal
    # with it. map stays put too, but it only exists once slam_toolbox has
    # matched a scan, and under load it stops being published for seconds at
    # a time; every display that needs it then warns. odom comes from the EKF
    # and is always there. Goals are stamped in this frame and nav2 transforms
    # them itself, so pointing still works.
    #
    # ⚠️ For the ToF geometry checks, switch this to base_link in the GUI.
    #    Those ask where a box is *relative to the vehicle*, and holding the
    #    vehicle still on screen makes a sign error obvious the moment the box
    #    appears on the wrong side.
    # 정적 지도를 쓸 때는 map 으로 볼 것 -- 그래야 스캔이 지도 벽 위에 얹히는지
    # 보인다. odom 으로 보면 지도가 차와 함께 떠다녀 비교가 안 된다.
    #
    # SLAM 으로 지도를 만드는 중이라면 odom 이 낫다: map 은 slam_toolbox 가 첫
    # 스캔을 맞춰야 생기고, 부하가 걸리면 몇 초씩 끊긴다.
    Fixed Frame: map
    Background Color: 48; 48; 48
    # 10, not 30. RViz on this Jetson costs a full core at 30 Hz, and over
    # xrdp the desktop stack costs two more. On 2026-08-07 that starved
    # slam_toolbox until it dropped scans ("queue is full") and stopped
    # publishing map->odom, which then made every display warn -- the display
    # was reporting a problem it had caused.
    Frame Rate: 10
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    # "2D Goal Pose" -- drag to set position and heading. bt_navigator picks
    # this up straight off /goal_pose, so no action client is needed to drive
    # the vehicle by hand from here.
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    # "2D Pose Estimate" -- only needed if SLAM starts up badly localised.
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
      Topic:
        Value: /initialpose
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 2.5
      Pitch: 0.8
      Yaw: 3.14
      Focal Point:
        X: 0.3
        Y: 0
        Z: 0
      Target Frame: base_link
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  Displays:
    collapsed: false
