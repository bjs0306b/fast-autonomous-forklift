# === 이 파일은 "템플릿"입니다. 실제 값은 여기 쓰지 마세요. ===
#
# 배포 서버(EC2)의 `backend.env` 를 만들기 위한 템플릿이다.
#   cp backend.env.example backend.env    # 서버에서만, 커밋하지 않는다
#
# docker-compose.yml 의 backend 서비스가 `env_file` 로 통째로 읽어 컨테이너 환경변수로
# 넣는다. compose 자신이 쓰는 값(MYSQL_ROOT_PASSWORD, NEXT_PUBLIC_*)은 여기가 아니라
# `.env` 에 있다 — 두 파일은 역할이 다르다.

# 컨테이너 안에서 바인딩할 주소·포트. 0.0.0.0 이어야 호스트 포트 매핑이 동작한다.
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=

# MySQL — 호스트명은 compose 서비스명(`mysql`)을 쓴다. localhost 가 아니다.
# serverTimezone=Asia/Seoul 을 빼면 시각이 어긋난다.
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# MQTT. 평문 1883 과 TLS 8883 중 어느 쪽인지에 따라 URL 스킴이 달라진다
# (tcp:// vs ssl://). TLS 를 쓰면 Dockerfile.backend 가 구워 넣은 CA 를 신뢰한다.
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=

# 정상 측정 완료 후 다음 화물과 PENDING 운반 작업을 자동 생성한다.
CARGO_INTAKE_AUTO_CREATE_ENABLED=true
CARGO_INTAKE_NEXT_DELAY_MS=5000

# 측정 세션·MOVE 자동 만료. 아래는 코드 기본값(application.yml)과 같은 값이라
# 그대로 두면 동작이 안 바뀐다 — 바꿀 때만 건드린다.
#
# ⚠️ **이 값들을 `.env` 에 넣으면 아무 효과가 없다.** backend 컨테이너는 `env_file`
#    로 이 파일만 읽는다. `.env` 는 compose 자신의 변수 치환용이라 백엔드까지
#    전달되지 않고, **에러 없이 기본값이 그대로 쓰인다**(2026-08-06 정정).
#
# 세션 TTL 60초는 실측 근거가 있다: 측정 창의 상한이 정지 대기 ≤5.0초 + 젯슨 추론
# ≤1.5초 + REST ~0.2초 ≈ 6초라 10배 여유다. `--once` 로 잰 총 소요(약 10초)에는
# 파이썬 기동·ONNX 로드가 섞여 있으므로 그 숫자를 TTL 예산으로 쓰면 안 된다.
STATION_SESSION_TTL_SECONDS=60
STATION_MOVE_TTL_SECONDS=300
STATION_SESSION_CLEANUP_INTERVAL_MS=5000

# ⚠️ 브라우저가 다른 PC 에서 열리면 반드시 실제 접속 Origin 을 넣어야 한다.
# 코드 기본값은 http://localhost:3000 이라 그대로 두면 전부 CORS 차단된다.
CORS_ALLOWED_ORIGINS=
WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=
