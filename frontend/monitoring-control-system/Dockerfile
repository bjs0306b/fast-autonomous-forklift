FROM node:22-alpine AS deps

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS build

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_ISAAC_WEBRTC_SERVER
ARG NEXT_PUBLIC_ISAAC_WEBRTC_SIGNAL_PORT=49100
ARG NEXT_PUBLIC_ISAAC_WEBRTC_MEDIA_PORT=47998
ARG NEXT_PUBLIC_AI_MEASUREMENT_STREAM_URL
ARG NEXT_PUBLIC_ONBOARD_STREAM_URL

ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_ISAAC_WEBRTC_SERVER=$NEXT_PUBLIC_ISAAC_WEBRTC_SERVER
ENV NEXT_PUBLIC_ISAAC_WEBRTC_SIGNAL_PORT=$NEXT_PUBLIC_ISAAC_WEBRTC_SIGNAL_PORT
ENV NEXT_PUBLIC_ISAAC_WEBRTC_MEDIA_PORT=$NEXT_PUBLIC_ISAAC_WEBRTC_MEDIA_PORT
ENV NEXT_PUBLIC_AI_MEASUREMENT_STREAM_URL=$NEXT_PUBLIC_AI_MEASUREMENT_STREAM_URL
ENV NEXT_PUBLIC_ONBOARD_STREAM_URL=$NEXT_PUBLIC_ONBOARD_STREAM_URL

RUN npx tsc --noEmit
RUN npm run build

FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app/package.json ./
COPY --from=build /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public
COPY --from=build /app/next.config.* ./

EXPOSE 3000

CMD ["npm", "run", "start", "--", "--hostname", "0.0.0.0", "--port", "3000"]
