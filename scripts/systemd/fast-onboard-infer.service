[Unit]
# 젯슨(Orin Nano) 온보드 추론 서버 — 스테이션이 REST 로 붙는다.
# 설치·검증 절차: docs/deploy/jetson-inference-service.md
#
# 이 유닛이 없으면 재부팅 때 서버가 올라오지 않는다. 2026-08-03 실측으로
# 실제 발생을 확인했다(재부팅 2시간 뒤에도 8877 리스닝 없음).
Description=FAST onboard TensorRT inference server (station)
After=network-online.target
Wants=network-online.target

# ⚠️ StartLimit* 는 [Service] 가 아니라 **[Unit]** 섹션 키다.
#    [Service] 에 두면 systemd 가 `Unknown key name ... ignoring` 으로 조용히
#    무시해서, 재시작 제한이 있는 것처럼 보이는데 실제로는 없다.
#    (2026-08-03 `systemd-analyze verify` 로 잡음.)
#
#    CUDA 컨텍스트를 못 잡는 상황(§3)에서는 재시작해도 계속 실패하므로,
#    무한 재시작으로 저널을 채우지 않도록 제한한다.
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=orin
Group=orin
WorkingDirectory=/home/orin/dimeval

# ⚠️ PYTHONPATH 가 없으면 `ModuleNotFoundError: No module named 'perception'` 로
#    즉시 죽는다. 스크립트가 레포 루트가 아니라 dimeval/ 에 있어서 생기는 문제다.
Environment=PYTHONPATH=/home/orin/dimeval/src

# ⚠️ --score 는 **스테이션의 가장 낮은 클래스 임계보다 낮아야** 한다.
#
#    서버 기본값은 0.5 인데 스테이션 파렛트 임계는 0.4 다(ai/src/station/config.py,
#    리그 평가셋 30장 실측 근거). 기본값으로 띄우면 0.4~0.5 파렛트가 **서버에서
#    먼저 버려져** 스테이션 필터에 도달조차 못 한다.
#
#    이건 에러를 내지 않는다 — 같은 장면이 로컬은 `ok`, 보드는 `dimensions_only`
#    가 되어 전복·편하중 판정이 통째로 빠진다(2026-07-31 실측, 상세는
#    ai/src/station/remote_detector.py 의 docstring).
#
#    원칙: **서버는 후보만 돌려주고 판정은 스테이션이 쥔다.**
ExecStart=/usr/bin/python3 /home/orin/dimeval/onboard_infer_server.py \
    --engine /home/orin/calib/station_m800_fp32.engine \
    --plugin /home/orin/mmdeploy/build_trt/lib/libmmdeploy_tensorrt_ops.so \
    --host 0.0.0.0 \
    --port 8877 \
    --input-size 800 \
    --score 0.05

Restart=always
RestartSec=10
# (재시작 제한은 [Unit] 섹션에 있다 — 위 주석 참조)

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
